@page "/settings/payments/stripe"
@attribute [Authorize(Roles = "Admin")]
@using CloudDentalOffice.Portal.Models
@using CloudDentalOffice.Portal.Services.Tenancy
@inject IStripeConnectService StripeConnect
@inject IStripeProductionReadinessService ReadinessService
@inject ITenantProvider TenantProvider
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Stripe Payments</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 mb-8">
    <MudText Typo="Typo.h4">Stripe Payments</MudText>
    <MudText Color="Color.Secondary" Class="mb-5">Connect the practice directly to Stripe for patient payment settlement.</MudText>
    <MudPaper Class="pa-5" Elevation="2">
        @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
        else if (_status is null) { <MudAlert Severity="Severity.Warning">Stripe is not configured for this practice.</MudAlert> }
        else
        {
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h5">Stripe Connect</MudText>
                <MudChip T="string" Color="@StatusColor()">@_status.Status</MudChip>
            </div>
            <MudAlert Severity="@(_status.Environment == PaymentProcessorEnvironment.Production ? Severity.Error : Severity.Warning)"
                      Dense="true" Class="mb-4">
                <strong>@(_status.Environment == PaymentProcessorEnvironment.Production ? "LIVE" : "SANDBOX / TEST")</strong>
                — @(_status.Environment == PaymentProcessorEnvironment.Production
                    ? "Real patient payments and payouts are enabled for this configuration."
                    : "Test payments must only be used with an explicitly approved test tenant.")
            </MudAlert>
            <MudText>Charges enabled: @YesNo(_status.ChargesEnabled)</MudText>
            <MudText>Payouts enabled: @YesNo(_status.PayoutsEnabled)</MudText>
            <MudText>Details submitted: @YesNo(_status.DetailsSubmitted)</MudText>
            <MudAlert Severity="Severity.Info" Dense="true" Class="my-4">
                Business, identity, tax, and bank information is entered directly on Stripe's hosted onboarding pages. CloudDentalOffice never receives bank or identity documents.
            </MudAlert>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="Connect">
                @(_status.ConnectedAccountId is null ? "Connect Stripe" : "Continue Stripe onboarding")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Class="ml-2" Disabled="_busy" OnClick="RefreshStatus">Refresh status</MudButton>
            @if (_status.Enabled)
            {
                <MudButton Color="Color.Error" Variant="Variant.Text" Class="ml-2" Disabled="_busy" OnClick="Disable">Disable locally</MudButton>
            }

            @if (_readiness is not null)
            {
                <MudDivider Class="my-5" />
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.h6">Production readiness</MudText>
                    <MudChip T="string" Color="@(_readiness.PilotReady ? Color.Success : Color.Warning)">
                        @(_readiness.PilotReady ? "Ready" : "Action required")
                    </MudChip>
                </div>
                <MudText>Webhook: @(_readiness.WebhookHealthy ? "Healthy" : "Needs attention")</MudText>
                <MudText>Last successful payment event: @DisplayDate(_readiness.LastSuccessfulPaymentEventAt)</MudText>
                <MudText>Pending webhook events: @_readiness.PendingInboxCount</MudText>
                <MudText>Failed webhook events: @_readiness.FailedInboxCount</MudText>
                <MudText>Reconciliation: @_readiness.ReconciliationStatus (@DisplayDate(_readiness.LastReconciliationAt))</MudText>
                @foreach (var blocker in _readiness.Blockers)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@blocker</MudAlert>
                }
            }
        }
    </MudPaper>
</MudContainer>

@code {
    private StripeConnectStatus? _status; private StripeProductionReadiness? _readiness;
    private bool _loading = true, _busy;
    protected override async Task OnInitializedAsync() { await Load(); _loading = false; }
    private async Task Load()
    {
        _status = null;
        _readiness = null;
        try
        {
            _status = await StripeConnect.RefreshStatusAsync(TenantProvider.TenantId);
        }
        catch (PaymentProcessorUnavailableException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (Exception) { Snackbar.Add("Stripe status could not be refreshed.", Severity.Error); }
        try { _readiness = await ReadinessService.GetAsync(TenantProvider.TenantId); }
        catch (Exception) { Snackbar.Add("Stripe readiness could not be loaded.", Severity.Warning); }
    }
    private async Task Connect()
    {
        await Run(async () =>
        {
            var auth = await AuthenticationState.GetAuthenticationStateAsync();
            var email = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? auth.User.Identity?.Name ?? throw new InvalidOperationException("Administrator email is unavailable.");
            var link = await StripeConnect.CreateOnboardingLinkAsync(TenantProvider.TenantId, email,
                PageUri("refresh"), PageUri("return"));
            Navigation.NavigateTo(link.Url.AbsoluteUri, forceLoad: true);
        });
    }
    private Task RefreshStatus() => Run(Load);
    private Task Disable() => Run(async () => { await StripeConnect.DisableAsync(TenantProvider.TenantId); await Load(); });
    private async Task Run(Func<Task> action)
    {
        _busy = true; try { await action(); }
        catch (Exception ex) { Snackbar.Add(ex is StripeConnectException ? "Stripe could not complete the request." : ex.Message, Severity.Error); }
        finally { _busy = false; }
    }
    private Uri PageUri(string flow) => new(Navigation.ToAbsoluteUri($"/settings/payments/stripe?flow={flow}").AbsoluteUri);
    private Color StatusColor() => _status?.Status == PaymentProcessorOnboardingStatus.Enabled ? Color.Success : Color.Warning;
    private static string YesNo(bool value) => value ? "Yes" : "No";
    private static string DisplayDate(DateTime? value) => value?.ToLocalTime().ToString("g") ?? "Not yet";
}
