@page "/vision/clinical-notes"
@using CloudDentalOffice.Contracts.Vision
@inject IVisionService VisionService
@inject ISnackbar Snackbar

<PageTitle>Clinical Notes - Cloud Dental Office</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <PageHeader Title="Clinical notes" Subtitle="Vision-observed procedures · AI-drafted notes · Provider review required" Section="AI Vision" />

    @* ── Notes List ── *@
    <MudGrid>
        <MudItem xs="12" md="@(_selectedNote == null ? 12 : 5)">
            <MudPaper Elevation="0" Style="background-color: var(--cdo-raised); border: 1px solid var(--cdo-line);">
                <MudToolBar Dense="true" Style="background-color: var(--cdo-raised);">
                    <MudText Typo="Typo.subtitle1" Style="color: var(--cdo-text-muted);">Draft Notes</MudText>
                    <MudSpacer />
                    <MudToggleGroup T="string" @bind-Value="_statusFilter" Style="border-color: var(--cdo-line);">
                        <MudToggleItem Value="@("pending")" Text="Pending Review" />
                        <MudToggleItem Value="@("approved")" Text="Approved" />
                        <MudToggleItem Value="@("all")" Text="All" />
                    </MudToggleGroup>
                </MudToolBar>

                <MudList T="ClinicalNoteDraftDto" Dense="true" Style="background-color: transparent;">
                    @foreach (var note in FilteredNotes)
                    {
                        <MudListItem OnClick="@(() => _selectedNote = note)"
                                     Style="@($"border-left: 3px solid {(note.ApprovedByProvider ? "var(--cdo-success)" : "var(--cdo-warning)")}; margin: 4px 8px; background-color: {(_selectedNote?.Id == note.Id ? "var(--cdo-accent-soft)" : "transparent")}; border-radius: 4px;")">
                            <div class="d-flex justify-space-between align-center">
                                <div>
                                    <MudText Typo="Typo.body2" Style="color: var(--cdo-text); font-weight: 500;">
                                        @(note.CdtCode ?? "—") @(note.ProcedureName ?? "Procedure Note")
                                    </MudText>
                                    <MudText Typo="Typo.caption" Style="color: var(--cdo-text-subtle);">
                                        @note.ObservationStart.ToString("MM/dd/yy HH:mm") ·
                                        @note.Observations.Count observations
                                    </MudText>
                                </div>
                                <div>
                                    @if (note.ApprovedByProvider)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="color: var(--cdo-success);" />
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                                 Variant="Variant.Outlined" Style="font-size: 0.65rem;">
                                            REVIEW
                                        </MudChip>
                                    }
                                </div>
                            </div>
                        </MudListItem>
                    }
                    @if (!FilteredNotes.Any())
                    {
                        <MudListItem>
                            <MudText Typo="Typo.body2" Style="color: var(--cdo-text-subtle); text-align: center;" Class="pa-4">
                                No notes match the current filter
                            </MudText>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        </MudItem>

        @* ── Note Detail / Review ── *@
        @if (_selectedNote != null)
        {
            <MudItem xs="12" md="7">
                <MudPaper Class="pa-4" Elevation="0"
                          Style="@($"background-color: var(--cdo-raised); border: 1px solid {(_selectedNote.ApprovedByProvider ? "var(--cdo-success-line)" : "var(--cdo-warning-line)")};")">

                    <div class="d-flex justify-space-between align-center mb-3">
                        <div>
                            <MudText Typo="Typo.h6" Style="color: var(--cdo-text);">
                                @(_selectedNote.CdtCode ?? "—") @(_selectedNote.ProcedureName ?? "Procedure Note")
                            </MudText>
                            <MudText Typo="Typo.caption" Style="color: var(--cdo-text-subtle);">
                                Observed @_selectedNote.ObservationStart.ToString("MM/dd/yy HH:mm")
                                – @_selectedNote.ObservationEnd.ToString("HH:mm")
                            </MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       Style="color: var(--cdo-text-subtle);" OnClick="@(() => _selectedNote = null)" />
                    </div>

                    @* ── Observation Timeline ── *@
                    @if (_selectedNote.Observations.Any())
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: var(--cdo-text-subtle);">
                            <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Small" Class="mr-1" />
                            Procedure Observations
                        </MudText>
                        <MudPaper Class="pa-2 mb-3" Elevation="0" Style="background-color: var(--cdo-raised); max-height: 200px; overflow-y: auto;">
                            @foreach (var obs in _selectedNote.Observations)
                            {
                                <div class="d-flex align-center gap-2 pa-1" style="border-bottom: 1px solid var(--cdo-line);">
                                    <MudText Typo="Typo.caption" Style="color: var(--cdo-text-subtle); min-width: 50px;">
                                        @obs.Timestamp.ToString("HH:mm:ss")
                                    </MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Style="border-color: var(--cdo-line); color: var(--cdo-text-muted); font-size: 0.65rem;">
                                        @obs.DetectedInstrument
                                    </MudChip>
                                    <MudText Typo="Typo.caption" Style="color: var(--cdo-text-muted);">
                                        @obs.InferredAction
                                    </MudText>
                                    <MudSpacer />
                                    <MudText Typo="Typo.caption" Style="color: var(--cdo-text-subtle);">
                                        @((obs.Confidence * 100).ToString("F0"))%
                                    </MudText>
                                </div>
                            }
                        </MudPaper>
                    }

                    @* ── AI-Generated Note ── *@
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: var(--cdo-text-subtle);">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Class="mr-1" Style="color: var(--cdo-warning);" />
                        AI-Generated Note
                    </MudText>

                    @if (_selectedNote.ApprovedByProvider)
                    {
                        <MudPaper Class="pa-3 mb-3" Elevation="0"
                                  Style="background-color: var(--cdo-raised); border-left: 3px solid var(--cdo-success);">
                            <MudText Typo="Typo.body2" Style="color: var(--cdo-success); white-space: pre-wrap;">
                                @_selectedNote.DraftNoteText
                            </MudText>
                        </MudPaper>
                        <MudAlert Severity="Severity.Success" Dense="true"
                                  Style="background-color: var(--cdo-raised); color: var(--cdo-success);">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                            Approved by provider on @(_selectedNote.ApprovedAt?.ToString("MM/dd/yy HH:mm"))
                        </MudAlert>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_editedNoteText"
                                      Lines="8" Variant="Variant.Outlined"
                                      Style="color: var(--cdo-text); background-color: var(--cdo-raised);"
                                      Placeholder="AI-generated note text..."
                                      Class="mb-3" />

                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3"
                                  Style="background-color: var(--cdo-warning-soft); color: var(--cdo-warning);">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                            This note was AI-generated from vision observations. Provider review and approval required before saving to patient chart.
                        </MudAlert>

                        <div class="d-flex gap-2 justify-end">
                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Style="border-color: var(--cdo-line); color: var(--cdo-text-muted);"
                                       OnClick="RegenerateNote">
                                Regenerate
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                       Style="background-color: var(--cdo-success); color: var(--cdo-on-accent);"
                                       OnClick="ApproveNote">
                                Approve & Save to Chart
                            </MudButton>
                        </div>
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@code {
    private List<ClinicalNoteDraftDto> _notes = new();
    private ClinicalNoteDraftDto? _selectedNote;
    private string _statusFilter = "pending";
    private string _editedNoteText = "";

    private IEnumerable<ClinicalNoteDraftDto> FilteredNotes => _statusFilter switch
    {
        "pending" => _notes.Where(n => !n.ApprovedByProvider),
        "approved" => _notes.Where(n => n.ApprovedByProvider),
        _ => _notes
    };

    protected override async Task OnInitializedAsync()
    {
        try { _notes = await VisionService.GetClinicalNotesAsync(limit: 50); }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
    }

    private void SelectNote(ClinicalNoteDraftDto note)
    {
        _selectedNote = note;
        _editedNoteText = note.DraftNoteText ?? "";
    }

    private async Task ApproveNote()
    {
        if (_selectedNote == null) return;
        try
        {
            var approved = await VisionService.ApproveClinicalNoteAsync(_selectedNote.Id);
            var idx = _notes.FindIndex(n => n.Id == _selectedNote.Id);
            if (idx >= 0) _notes[idx] = approved;
            _selectedNote = approved;
            Snackbar.Add("Clinical note approved and saved to patient chart", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
    }

    private void RegenerateNote()
    {
        // TODO: call Azure OpenAI to regenerate with different prompt
        Snackbar.Add("Note regeneration requires Azure OpenAI configuration", Severity.Info);
    }
}
