@page "/insurance-to-verify"
@attribute [Authorize(Roles = CloudDentalOffice.Portal.Services.Auth.StaffRoles.PayerManagers)]
@using CloudDentalOffice.Portal.Models
@using Microsoft.Extensions.Options
@inject ICoverageVerificationQueue Queue
@inject IWebsiteInsuranceCheckService WebsiteChecks
@inject IPatientService PatientService
@inject IOptions<CoverageVerificationOptions> VerificationOptions
@inject TimeProvider Time
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<InsuranceToVerify> Logger

<PageTitle>Insurance to Verify - Cloud Dental Office</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <PageHeader Title="Insurance to verify" Subtitle="Upcoming appointments whose dental coverage isn't confirmed. Coverage is checked automatically; these need the front desk." Section="Front desk">
        <Actions>
            <MudSwitch T="bool" Value="_includeVerified" ValueChanged="IncludeVerifiedChanged" Color="Color.Primary" Label="Show verified" />
            <MudSelect T="int" Value="_days" ValueChanged="DaysChanged" Label="Appointments" Dense Variant="Variant.Outlined">
                <MudSelectItem Value="1">Today</MudSelectItem>
                <MudSelectItem Value="3">Next 3 days</MudSelectItem>
                <MudSelectItem Value="7">Next 7 days</MudSelectItem>
                <MudSelectItem Value="14">Next 14 days</MudSelectItem>
            </MudSelect>
        </Actions>
    </PageHeader>

    @if (_websiteChecks.Count > 0)
    {
        <MudPaper Class="pa-4 mt-4" Style="background:var(--cdo-surface);border:1px solid var(--cdo-line-strong);">
            <MudText Typo="Typo.h6" Color="Color.Primary">From the website</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Visitors who asked to check their insurance. Match each one to a patient, then email the secure link that asks for their member ID.</MudText>
            <MudTable Items="_websiteChecks" Hover Dense>
                <HeaderContent>
                    <MudTh>Received</MudTh><MudTh>Visitor</MudTh><MudTh>Insurance</MudTh><MudTh>Patient</MudTh>
                    <MudTh>What to do</MudTh><MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Received">@Local(context.ReceivedAt).ToString("M/d h:mm tt")</MudTd>
                    <MudTd DataLabel="Visitor">
                        <div>@context.Name@(context.WantsAppointment ? " · wants an appointment" : "")</div>
                        <MudText Typo="Typo.caption">@string.Join(" · ", new[] { context.Phone, context.Email }.Where(v => !string.IsNullOrWhiteSpace(v)))</MudText>
                    </MudTd>
                    <MudTd DataLabel="Insurance">@context.Carrier@(context.Plan is null ? "" : $" · {context.Plan}")</MudTd>
                    <MudTd DataLabel="Patient">@(context.PatientName ?? "—")</MudTd>
                    <MudTd DataLabel="What to do">@WebsiteStepText(context)</MudTd>
                    <MudTd>
                        <MudStack Row Spacing="1">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => MatchWebsiteCheck(context))">
                                @(context.PatientId is null ? "Match patient" : "Change patient")
                            </MudButton>
                            @if (context.Step is WebsiteInsuranceCheckStep.SendLink or WebsiteInsuranceCheckStep.LinkFailed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_sendingId is not null)"
                                           OnClick="@(() => SendWebsiteLink(context))">
                                    @(_sendingId == context.Id ? "Sending…" : context.Step == WebsiteInsuranceCheckStep.LinkFailed ? "Send again" : "Email secure link")
                                </MudButton>
                            }
                            @if (context.PatientId is not null)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => OpenWebsiteInsurance(context))">Insurance</MudButton>
                            }
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => CloseWebsiteCheck(context))">Done</MudButton>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }

    <MudPaper Class="pa-4 mt-4" Style="background:var(--cdo-surface);border:1px solid var(--cdo-line-strong);">
        @if (_loading) { <MudProgressLinear Indeterminate Color="Color.Primary" /> }
        else
        {
            <MudTable Items="_items" Hover Dense>
                <HeaderContent>
                    <MudTh>Appointment</MudTh><MudTh>Patient</MudTh><MudTh>Plan</MudTh><MudTh>Status</MudTh>
                    <MudTh>What to do</MudTh><MudTh>Last checked</MudTh><MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Appointment">@Local(context.AppointmentStart).ToString("ddd M/d h:mm tt")</MudTd>
                    <MudTd DataLabel="Patient">@context.PatientName</MudTd>
                    <MudTd DataLabel="Plan">@(context.PlanName ?? (context.SentPlanId is null ? "—" : "Patient sent a plan"))</MudTd>
                    <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@StateColor(context.State)">@StateLabel(context.State)</MudChip></MudTd>
                    <MudTd DataLabel="What to do">@WhatToDo(context)</MudTd>
                    <MudTd DataLabel="Last checked">@(context.LastCheckedAt is { } at ? Local(at).ToString("M/d h:mm tt") : "—")</MudTd>
                    <MudTd>
                        <MudStack Row Spacing="1">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => OpenInsurance(context))">Insurance</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_checkingId is not null)"
                                       OnClick="@(() => CheckNow(context))">
                                @(_checkingId == context.Id ? "Checking…" : "Check now")
                            </MudButton>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>@(_includeVerified ? "No upcoming appointments." : "Every upcoming appointment's coverage is verified.")</MudText></NoRecordsContent>
            </MudTable>
            @if (!VerificationOptions.Value.Enabled)
            {
                <MudAlert Severity="Severity.Info" Dense Class="mt-3">Automatic checks are turned off; this list updates only when staff check coverage.</MudAlert>
            }
        }
    </MudPaper>
</MudContainer>

@code {
    private IReadOnlyList<CoverageQueueItem> _items = [];
    private IReadOnlyList<WebsiteInsuranceCheckItem> _websiteChecks = [];
    private Guid? _sendingId;
    private int _days = 3;
    private bool _includeVerified;
    private bool _loading = true;
    private long? _checkingId;
    private TimeZoneInfo _zone = TimeZoneInfo.Local;

    protected override Task OnInitializedAsync()
    {
        _zone = VerificationOptions.Value.ResolveTimeZone(Time);
        return Load();
    }

    private async Task Load()
    {
        _loading = true;
        try { _items = await Queue.GetAsync(_days, _includeVerified); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load the insurance verification queue");
            Snackbar.Add("Unable to load the verification list.", Severity.Error);
        }
        finally { _loading = false; }
        await LoadWebsiteChecks();
    }

    // Separate from the appointment list, so a problem here never hides it.
    private async Task LoadWebsiteChecks()
    {
        try { _websiteChecks = await WebsiteChecks.GetOpenAsync(); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load website insurance checks");
            Snackbar.Add("Unable to load insurance checks from the website.", Severity.Warning);
        }
    }

    private async Task MatchWebsiteCheck(WebsiteInsuranceCheckItem check)
    {
        var dialog = await DialogService.ShowAsync<WebsiteInsuranceCheckMatchDialog>($"Match {check.Name} to a patient",
            new DialogParameters<WebsiteInsuranceCheckMatchDialog> { { x => x.Check, check } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (!result.Canceled) await LoadWebsiteChecks();
    }

    private async Task SendWebsiteLink(WebsiteInsuranceCheckItem check)
    {
        _sendingId = check.Id;
        try
        {
            var request = await WebsiteChecks.SendLinkAsync(check.Id);
            if (request.Status == CoverageIntakeStatus.Sent) Snackbar.Add($"Secure link emailed to {request.RecipientEmail}.", Severity.Success);
            else Snackbar.Add("The email couldn't be sent. Try again, or call the patient.", Severity.Warning);
        }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not send the coverage link for website check {CheckId}", check.Id);
            Snackbar.Add("The link could not be sent. Try again later.", Severity.Error);
        }
        finally { _sendingId = null; }
        await LoadWebsiteChecks();
    }

    private async Task OpenWebsiteInsurance(WebsiteInsuranceCheckItem check)
    {
        var patient = await PatientService.GetPatientByIdAsync(check.PatientId!.Value.ToString());
        if (patient is null)
        {
            Snackbar.Add("This patient could not be found.", Severity.Warning);
            return;
        }
        var sentPlan = check.SentPlanId is { } planId ? await Queue.GetSentPlanAsync(planId) : null;
        var dialog = DialogService.Show<PatientInsuranceDialog>($"Insurance & Eligibility — {patient.FullName}",
            new DialogParameters { ["Patient"] = patient, ["SentPlan"] = sentPlan },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });
        await dialog.Result;
        await LoadWebsiteChecks();
    }

    private async Task CloseWebsiteCheck(WebsiteInsuranceCheckItem check)
    {
        try { await WebsiteChecks.CloseAsync(check.Id); }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        await LoadWebsiteChecks();
    }

    private string WebsiteStepText(WebsiteInsuranceCheckItem check) => check.Step switch
    {
        WebsiteInsuranceCheckStep.MatchPatient => "Match the visitor to a patient, or create one.",
        WebsiteInsuranceCheckStep.CallPatient => "The patient has no email on file. Call them for their dental plan.",
        WebsiteInsuranceCheckStep.SendLink => "Email the secure link for their member ID.",
        WebsiteInsuranceCheckStep.WaitingForPatient => check.LinkSentAt is { } sent
            ? $"Link emailed {Local(sent):M/d}; waiting for the patient." : "Link emailed; waiting for the patient.",
        WebsiteInsuranceCheckStep.LinkFailed => "The email couldn't be delivered. Send again or call the patient.",
        WebsiteInsuranceCheckStep.AddCoverage => "The patient sent their plan. Open Insurance, add it and check eligibility.",
        WebsiteInsuranceCheckStep.NoInsurance => "The patient says they have no dental insurance. Mark done.",
        WebsiteInsuranceCheckStep.CoverageOnFile => "Coverage is on file. Check eligibility under Insurance, then mark done.",
        _ => string.Empty
    };

    private async Task DaysChanged(int value) { _days = value; await Load(); }
    private async Task IncludeVerifiedChanged(bool value) { _includeVerified = value; await Load(); }

    private async Task CheckNow(CoverageQueueItem item)
    {
        _checkingId = item.Id;
        try
        {
            await Queue.CheckNowAsync(item.Id);
            await Load();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Coverage check failed for verification {VerificationId}", item.Id);
            Snackbar.Add("The check could not be completed. Try again later.", Severity.Error);
        }
        finally { _checkingId = null; }
    }

    private async Task OpenInsurance(CoverageQueueItem item)
    {
        var patient = await PatientService.GetPatientByIdAsync(item.PatientId.ToString());
        if (patient is null)
        {
            Snackbar.Add("This patient could not be found.", Severity.Warning);
            return;
        }
        // A dental plan the patient typed in through their intake link, for staff to review and add.
        var sentPlan = item.SentPlanId is { } planId ? await Queue.GetSentPlanAsync(planId) : null;
        var dialog = DialogService.Show<PatientInsuranceDialog>($"Insurance & Eligibility — {patient.FullName}",
            // Check against this appointment's date and provider, not today's defaults.
            new DialogParameters
            {
                ["Patient"] = patient,
                ["ServiceDate"] = DateOnly.FromDateTime(Local(item.AppointmentStart)),
                ["ProviderId"] = item.ProviderId,
                ["SentPlan"] = sentPlan
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });
        await dialog.Result;
        // Pick up what changed in the dialog: a check there applies to this appointment,
        // and an edited coverage is checked again. Nothing changed means no payer call.
        try
        {
            await Queue.RefreshAsync(item.Id);
            await Load();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Coverage refresh failed for verification {VerificationId}", item.Id);
            Snackbar.Add("The coverage could not be re-checked. Try Check now.", Severity.Error);
        }
    }

    private DateTime Local(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), _zone);

    private static string StateLabel(EligibilityVerificationState? state) =>
        state is null ? "Not checked yet" : PatientInsuranceDialog.StateLabel(state);

    private string WhatToDo(CoverageQueueItem item) => item.State switch
    {
        null => "Waiting for the first check.",
        EligibilityVerificationState.Verified => "Nothing: coverage is active and includes dental.",
        EligibilityVerificationState.SelfPay => item.Reason ?? "The patient said they have no dental insurance.",
        EligibilityVerificationState.Unavailable when item.Attempts >= VerificationOptions.Value.MaxAttempts =>
            $"Couldn't reach the payer after {item.Attempts} tries. Verify by phone or the payer's portal.",
        EligibilityVerificationState.Unavailable => item.Reason is { } r ? $"{r} Retrying automatically." : "Retrying automatically.",
        _ => item.Reason ?? "Review the patient's coverage."
    };

    private static Color StateColor(EligibilityVerificationState? state) => state switch
    {
        EligibilityVerificationState.Verified => Color.Success,
        EligibilityVerificationState.SelfPay => Color.Default,
        EligibilityVerificationState.NotDental or EligibilityVerificationState.Inactive => Color.Error,
        EligibilityVerificationState.NeedsInfo or EligibilityVerificationState.Unconfirmed => Color.Warning,
        _ => Color.Info
    };
}
