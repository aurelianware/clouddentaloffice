@page "/appointments"
@page "/appointments/{PatientId:int}"
@using CloudDentalOffice.Portal.Models
@using MudBlazor
@using CloudDentalOffice.Portal.Components
@inject IAppointmentService AppointmentService
@inject IPatientService PatientService
@inject IProviderService ProviderService
@inject IEligibilityVerificationService Verification
@inject PatientContextService PatientContext
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Appointments - Cloud Dental Office</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <PageHeader Title="@(_selectedPatient != null ? $"Appointments for {_selectedPatient.FullName}" : "Appointments")" Subtitle="Schedule and manage patient appointments" Section="Front desk">
        <Details>
            @if (_selectedPatient != null)
            {
                <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                           OnClick="ClearPatientSelection" StartIcon="@Icons.Material.Filled.Clear" Class="mt-1">
                    Change Patient
                </MudButton>
            }
            else
            {
                <MudAutocomplete T="Patient" Value="_selectedPatient" Label="Select Patient (optional)"
                                 SearchFunc="@SearchPatients" ToStringFunc="@(p => p?.FullName ?? "")"
                                 Variant="Variant.Outlined" Dense="true" Clearable="true"
                                 ValueChanged="@OnPatientSelected" Class="mt-2" />
            }
        </Details>
        <Actions>
            <MudDatePicker Date="_selectedDate" Label="Select Date" 
                           Color="Color.Primary" Variant="Variant.Outlined"
                           DateChanged="@OnDateChanged" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenAddAppointmentDialog"
                       StartIcon="@Icons.Material.Filled.Add">
                New Appointment
            </MudButton>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-4" role="alert" aria-live="assertive">
            <MudText Typo="Typo.body1" Style="font-family: monospace; white-space: pre-wrap;">@_errorMessage</MudText>
        </MudAlert>
    }

    <MudPaper Class="pa-4 mt-4" Style="background: var(--cdo-surface); border: 1px solid var(--cdo-line-strong);">
        @if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else
        {
            <MudTable Items="@_appointments" Hover="true" Striped="true" Dense="true">
                <ToolBarContent>
                    <MudText Typo="Typo.h6" Style="color: var(--cdo-ink);">
                        Appointments for @_selectedDate?.ToString("MMMM dd, yyyy")
                    </MudText>
                    <MudSpacer />
                    <MudChip T="string" Color="Color.Info" Size="Size.Small">Total: @_appointments.Count</MudChip>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="color: var(--cdo-accent);">Time</MudTh>
                    <MudTh Style="color: var(--cdo-accent);">Patient</MudTh>
                    <MudTh Style="color: var(--cdo-accent);">Coverage</MudTh>
                    <MudTh Style="color: var(--cdo-accent);">Provider</MudTh>
                    <MudTh Style="color: var(--cdo-accent);">Type</MudTh>
                    <MudTh Style="color: var(--cdo-accent);">Duration</MudTh>
                    <MudTh Style="color: var(--cdo-accent);">Reason</MudTh>
                    <MudTh Style="color: var(--cdo-accent);">Status</MudTh>
                    <MudTh Style="color: var(--cdo-accent);">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Time">
                        <MudText Typo="Typo.body2" Style="color: var(--cdo-success); font-weight: bold;">
                            @context.AppointmentDateTime.ToLocalTime().ToString("hh:mm tt")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Patient">
                        <MudText Typo="Typo.body2">@GetPatientName(context.PatientId)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Coverage">
                        <CoverageSnapshotView Compact="true" Snapshot="@_coverage.GetValueOrDefault(context.PatientId)" />
                    </MudTd>
                    <MudTd DataLabel="Provider">
                        <MudText Typo="Typo.body2">@GetProviderName(context.ProviderId)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Type">
                        <MudText Typo="Typo.body2">@context.AppointmentType</MudText>
                    </MudTd>
                    <MudTd DataLabel="Duration">
                        <MudText Typo="Typo.body2">@context.DurationMinutes min</MudText>
                    </MudTd>
                    <MudTd DataLabel="Reason">
                        <MudText Typo="Typo.body2">@(context.ReasonForVisit ?? "-")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @{
                            var statusColor = context.Status switch
                            {
                                "Scheduled" => Color.Default,
                                "Confirmed" => Color.Info,
                                "Checked-In" => Color.Primary,
                                "InProgress" => Color.Warning,
                                "Completed" => Color.Success,
                                "Cancelled" => Color.Error,
                                "NoShow" => Color.Dark,
                                _ => Color.Default
                            };
                        }
                        <MudChip T="string" Color="statusColor" Size="Size.Small">@context.Status</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => EditAppointment(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteAppointment(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Style="color: var(--cdo-text-muted);">No appointments scheduled for this date</MudText>
                </NoRecordsContent>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter]
    public int? PatientId { get; set; }
    
    private List<Appointment> _appointments = new();
    private Dictionary<int, string> _patientNames = new();
    private Dictionary<int, string> _providerNames = new();
    private IReadOnlyDictionary<int, CoverageSnapshot> _coverage = new Dictionary<int, CoverageSnapshot>();
    private List<Patient> _allPatients = new();
    private Patient? _selectedPatient = null;
    private bool _loading = true;
    private DateTime? _selectedDate = DateTime.Today;
    private string? _errorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        var patientToLoad = PatientId ?? PatientContext.PatientId;
        if (patientToLoad.HasValue)
        {
            try
            {
                _selectedPatient = await PatientService.GetPatientByIdAsync(patientToLoad.Value.ToString());
                if (_selectedPatient != null)
                    PatientContext.Select(_selectedPatient);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error loading patient: {ex.Message}", Severity.Error);
            }
        }
        await LoadDisplayNames();
        await LoadAppointments();
    }

    private async Task LoadDisplayNames()
    {
        try
        {
            _allPatients = await PatientService.GetPatientsAsync();
            _patientNames = _allPatients.ToDictionary(p => p.PatientId, p => p.FullName);

            var providers = await ProviderService.GetProvidersAsync();
            _providerNames = providers.ToDictionary(p => p.ProviderId, p => p.FullName);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading appointment names: {ex.Message}", Severity.Warning);
        }
    }

    private string GetPatientName(int patientId) =>
        _patientNames.TryGetValue(patientId, out var name) ? name : "Unknown patient";

    private string GetProviderName(int providerId) =>
        _providerNames.TryGetValue(providerId, out var name) ? name : "Unknown provider";

    private async Task LoadAppointments()
    {
        try
        {
            _loading = true;
            _errorMessage = null;
            
            if (_selectedDate.HasValue)
            {
                var allAppointments = await AppointmentService.GetAppointmentsAsync(_selectedDate.Value);
                
                // Filter by patient if specified
                if (_selectedPatient != null)
                {
                    _appointments = allAppointments.Where(a => a.PatientId == _selectedPatient.PatientId).ToList();
                }
                else
                {
                    _appointments = allAppointments;
                }
                await LoadCoverage();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading appointments: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // Coverage is context for the schedule; a failure to load it never hides the appointments.
    private async Task LoadCoverage()
    {
        try
        {
            _coverage = await Verification.GetCoverageSnapshotsAsync(_appointments.Select(a => a.PatientId).ToList());
        }
        catch (Exception ex)
        {
            _coverage = new Dictionary<int, CoverageSnapshot>();
            Snackbar.Add($"Error loading coverage: {ex.Message}", Severity.Warning);
        }
    }

    private Task<IEnumerable<Patient>> SearchPatients(string searchString, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return Task.FromResult<IEnumerable<Patient>>(_allPatients.Take(10));

        return Task.FromResult<IEnumerable<Patient>>(_allPatients
            .Where(p => p.FullName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            .Take(10));
    }

    private async Task OnPatientSelected(Patient? patient)
    {
        _selectedPatient = patient;
        if (patient == null)
            PatientContext.Clear();
        else
            PatientContext.Select(patient);

        await LoadAppointments();
    }

    private async Task ClearPatientSelection()
    {
        PatientId = null;
        _selectedPatient = null;
        PatientContext.Clear();
        await LoadAppointments();
    }

    private async Task OnDateChanged(DateTime? date)
    {
        _selectedDate = date;
        await LoadAppointments();
    }

    private async Task OpenAddAppointmentDialog()
    {
        var parameters = new DialogParameters<AddEditAppointmentDialog>();
        
        if (_selectedPatient != null)
        {
            parameters.Add(x => x.PreselectedPatientId, _selectedPatient.PatientId);
        }

        var options = new DialogOptions 
        { 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<AddEditAppointmentDialog>("Schedule New Appointment", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadAppointments();
        }
    }

    private async Task EditAppointment(Appointment appointment)
    {
        var parameters = new DialogParameters<AddEditAppointmentDialog>
        {
            { x => x.ExistingAppointment, appointment }
        };

        var options = new DialogOptions 
        { 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<AddEditAppointmentDialog>("Edit Appointment", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadAppointments();
        }
    }

    private async Task DeleteAppointment(Appointment appointment)
    {
        var patientName = GetPatientName(appointment.PatientId);
        var result = await DialogService.ShowMessageBox(
            "Delete Appointment",
            $"Are you sure you want to delete the {appointment.AppointmentDateTime.ToLocalTime():g} appointment for {patientName}?",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            try
            {
                await AppointmentService.DeleteAppointmentAsync(appointment.ExternalId ?? appointment.AppointmentId.ToString());
                Snackbar.Add("Appointment deleted successfully", Severity.Success);
                await LoadAppointments();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting appointment: {ex.Message}", Severity.Error);
            }
        }
    }
}
