@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using CloudDentalOffice.Portal.Services.Auth
@using CloudDentalOffice.Portal.Theming

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a class="skip-link" href="#main-content">Skip to main content</a>

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="cdo-appbar" aria-label="Application header">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" aria-label="Toggle navigation menu"
                       aria-expanded="@(_drawerOpen ? "true" : "false")" />

        <img src="/images/logo-clouddental-mark.svg" alt="" class="cdo-appbar-logo" />
        <MudText Typo="Typo.h6" Class="appbar-title">Cloud Dental Office</MudText>

        <MudSpacer />

        <AuthorizeView>
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" aria-label="Account"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <div class="cdo-menu-signedin">
                    <MudText Typo="Typo.caption">Signed in as</MudText>
                    <MudText Typo="Typo.body2">@(context.User.Identity?.Name ?? "Unknown user")</MudText>
                </div>
                @if (StaffRoles.CanManagePayers(context.User))
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Tune" Href="/settings">Practice settings</MudMenuItem>
                }
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Sign out</MudMenuItem>
            </MudMenu>
        </AuthorizeView>
    </MudAppBar>
    
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Class="cdo-drawer">
        <div class="cdo-drawer-heading">Navigation</div>
        <MudNavMenu aria-label="Primary navigation">
            <AuthorizeView Roles="Patient">
                <MudNavGroup Title="Patient Portal" Icon="@Icons.Material.Filled.AccountCircle" Expanded="true">
                    <MudNavLink Href="/patient/billing" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">Billing</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

            @* Grouped by the job at hand, the way Cloud Health Office's navigation is: the
               front desk, the operatory, insurance, money, then running the practice. *@
            <AuthorizeView Roles="@StaffRoles.PayerManagers">
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>

                <MudNavGroup Title="Front desk" Icon="@Icons.Material.Filled.Badge" Expanded="true">
                    <MudNavLink Href="/patients" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Patients</MudNavLink>
                    <MudNavLink Href="/appointments" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Event">Appointments</MudNavLink>
                    <MudNavLink Href="/appointment-requests" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MarkEmailUnread">Appointment requests</MudNavLink>
                    <MudNavLink Href="/insurance-to-verify" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.VerifiedUser">Insurance to verify</MudNavLink>
                </MudNavGroup>

                <MudNavGroup Title="Clinical" Icon="@Icons.Material.Filled.MedicalServices" Expanded="true">
                    <MudNavLink Href="/chart" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Medication">Clinical chart</MudNavLink>
                    <MudNavLink Href="/treatment-plans" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment">Treatment plans</MudNavLink>
                    <MudNavLink Href="/prescriptions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocalPharmacy">e-Prescribe</MudNavLink>
                </MudNavGroup>

                <MudNavGroup Title="Insurance & claims" Icon="@Icons.Material.Filled.CloudSync" Expanded="true">
                    <MudNavLink Href="/claims" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">Claims</MudNavLink>
                    <MudNavLink Href="/payers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountBalance">Insurance payers</MudNavLink>
                    <MudNavLink Href="/fee-schedules" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.RequestQuote">Fee schedules</MudNavLink>
                </MudNavGroup>

                <AuthorizeView Roles="Admin,BillingAdmin,BillingStaff" Context="billing">
                    <MudNavLink Href="/billing" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Payments">Billing &amp; payments</MudNavLink>
                </AuthorizeView>

                <MudNavGroup Title="Insights" Icon="@Icons.Material.Filled.Insights" Expanded="false">
                    <MudNavLink Href="/pilot-metrics" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Speed">Pilot metrics</MudNavLink>
                    <AuthorizeView Roles="Admin" Context="admin">
                        <MudNavLink Href="/analytics/patient-acquisition" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.TrendingUp">Patient acquisition</MudNavLink>
                    </AuthorizeView>
                </MudNavGroup>

                <MudNavGroup Title="AI Vision" Icon="@Icons.Material.Filled.RemoveRedEye" Expanded="false">
                    <MudNavLink Href="/vision" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Overview</MudNavLink>
                    <MudNavLink Href="/vision/events" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Videocam">Events &amp; alerts</MudNavLink>
                    <MudNavLink Href="/vision/insurance-scans" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CreditCard">Insurance card scans</MudNavLink>
                    <MudNavLink Href="/vision/consent" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment">Consent recordings</MudNavLink>
                    <MudNavLink Href="/vision/clinical-notes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EditNote">Clinical notes</MudNavLink>
                    <MudNavLink Href="/vision/cabinet" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Lock">Cabinet access</MudNavLink>
                    <MudNavLink Href="/vision/devices" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Devices">Devices</MudNavLink>
                </MudNavGroup>

                <MudNavGroup Title="Practice setup" Icon="@Icons.Material.Filled.Settings" Expanded="false">
                    <MudNavLink Href="/settings" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Tune">Practice settings</MudNavLink>
                    <MudNavLink Href="/providers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MedicalInformation">Providers</MudNavLink>
                    <MudNavLink Href="/dentrix-import" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.UploadFile">Import from Dentrix</MudNavLink>
                    <AuthorizeView Roles="Admin" Context="admin">
                        <MudNavLink Href="/admin/organization/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Business">Organization</MudNavLink>
                        <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">Users</MudNavLink>
                        <MudNavLink Href="/settings/integrations/scheduling" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EventAvailable">Scheduling integrations</MudNavLink>
                        <MudNavLink Href="/settings/payments/stripe" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CreditScore">Stripe payments</MudNavLink>
                    </AuthorizeView>
                </MudNavGroup>
            </AuthorizeView>
        </MudNavMenu>
        
        <div class="cdo-drawer-footer">Cloud Dental Office</div>
    </MudDrawer>
    
    <MudMainContent id="main-content" tabindex="-1" role="main">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = CdoTheme.Create();

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task Logout()
    {
        if (AuthStateProvider is PortalAuthStateProvider authProvider)
        {
            await authProvider.LogoutAsync();
            Navigation.NavigateTo("/login", true);
        }
    }
}
