@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using CloudDentalOffice.Portal.Services.Auth
@using CloudDentalOffice.Portal.Theming

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a class="skip-link" href="#main-content">Skip to main content</a>

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="cdo-appbar" aria-label="Application header">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" aria-label="Toggle navigation menu"
                       aria-expanded="@(_drawerOpen ? "true" : "false")" />

        <img src="/images/logo-clouddental-mark.svg" alt="" class="cdo-appbar-logo" />
        <MudText Typo="Typo.h6" Class="appbar-title">Cloud Dental Office</MudText>

        <MudSpacer />

        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" aria-label="Notifications" />
        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" aria-label="User account" />
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" aria-label="Log out" title="Log out" />
    </MudAppBar>
    
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Class="cdo-drawer">
        <div class="cdo-drawer-heading">Navigation</div>
        <MudNavMenu aria-label="Primary navigation">
            <AuthorizeView Roles="Patient">
                <MudNavGroup Title="Patient Portal" Icon="@Icons.Material.Filled.AccountCircle" Expanded="true">
                    <MudNavLink Href="/patient/billing" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">Billing</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <!-- Dashboard -->
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>
            
            <!-- Practice Management -->
            <MudNavGroup Title="Practice Management" Icon="@Icons.Material.Filled.Business" Expanded="true">
                <MudNavLink Href="/patients" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
                    Patients
                </MudNavLink>
                <MudNavLink Href="/appointments" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Event">
                    Appointments
                </MudNavLink>
                <MudNavLink Href="/appointment-requests" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MarkEmailUnread">
                    Appointment Requests
                </MudNavLink>
                <MudNavLink Href="/insurance-to-verify" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.VerifiedUser">
                    Insurance to Verify
                </MudNavLink>
                <MudNavLink Href="/pilot-metrics" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Insights">
                    Pilot Metrics
                </MudNavLink>
                <MudNavLink Href="/treatment-plans" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment">
                    Treatment Plans
                </MudNavLink>
                <MudNavLink Href="/chart" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Medication">
                    Clinical Chart
                </MudNavLink>
                <MudNavLink Href="/prescriptions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocalPharmacy">
                    e-Prescribe
                </MudNavLink>
            </MudNavGroup>
            
            <!-- AI Vision -->
            <MudNavGroup Title="AI Vision" Icon="@Icons.Material.Filled.RemoveRedEye" Expanded="false">
                <MudNavLink Href="/vision" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">
                    Vision Dashboard
                </MudNavLink>
                <MudNavLink Href="/vision/devices" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Devices">
                    Devices
                </MudNavLink>
                <MudNavLink Href="/vision/events" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Videocam">
                    Events & Alerts
                </MudNavLink>
                <MudNavLink Href="/vision/insurance-scans" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CreditCard">
                    Insurance Card OCR
                </MudNavLink>
                <MudNavLink Href="/vision/consent" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment">
                    Consent Recordings
                </MudNavLink>
                <MudNavLink Href="/vision/cabinet" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Lock">
                    Cabinet Access
                </MudNavLink>
                <MudNavLink Href="/vision/clinical-notes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EditNote">
                    Clinical Notes
                </MudNavLink>
            </MudNavGroup>
            
            <!-- Claims -->
            <MudNavGroup Title="Claims" Icon="@Icons.Material.Filled.CloudSync" Expanded="false">
                <MudNavLink Href="/claims" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment">
                    Claims
                </MudNavLink>
                <MudNavLink Href="/payers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Business">
                    Insurance Payers
                </MudNavLink>
            </MudNavGroup>
            
            <AuthorizeView Roles="Admin,BillingAdmin,BillingStaff">
                <MudNavLink Href="/billing" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Receipt">Billing & Payments</MudNavLink>
            </AuthorizeView>
            
            <!-- Reports -->
            <MudNavLink Href="/reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.BarChart">
                Reports
            </MudNavLink>
            <AuthorizeView Roles="Admin">
                <MudNavLink Href="/analytics/patient-acquisition" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Insights">Patient Acquisition</MudNavLink>
            </AuthorizeView>
            
            <!-- Providers -->
            <MudNavLink Href="/providers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MedicalServices">
                Providers
            </MudNavLink>
            
            <!-- Admin (for Admin role only) -->
            <AuthorizeView Roles="Admin">
                <MudNavGroup Title="Administration" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
                    <MudNavLink Href="/admin/organization/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Business">
                        Organization Settings
                    </MudNavLink>
                    <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
                        User Management
                    </MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            
            <!-- Settings -->
            <MudNavGroup Title="Settings" Icon="@Icons.Material.Filled.Settings" Expanded="false">
                <MudNavLink Href="/settings" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Tune">Practice Settings</MudNavLink>
                <AuthorizeView Roles="Admin">
                    <MudNavGroup Title="Integrations" Icon="@Icons.Material.Filled.Extension" Expanded="false">
                        <MudNavLink Href="/settings/integrations/scheduling" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EventAvailable">Scheduling</MudNavLink>
                    </MudNavGroup>
                    <MudNavGroup Title="Payments" Icon="@Icons.Material.Filled.Payments" Expanded="false">
                        <MudNavLink Href="/settings/payments/stripe" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountBalance">Stripe</MudNavLink>
                    </MudNavGroup>
                </AuthorizeView>
            </MudNavGroup>
        </MudNavMenu>
        
        <div class="cdo-drawer-footer">Cloud Dental Office</div>
    </MudDrawer>
    
    <MudMainContent id="main-content" tabindex="-1" role="main">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = CdoTheme.Create();

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task Logout()
    {
        if (AuthStateProvider is PortalAuthStateProvider authProvider)
        {
            await authProvider.LogoutAsync();
            Navigation.NavigateTo("/login", true);
        }
    }
}
