{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "Sqlite",
  "Jwt": {
    "//": "Required for staff/admin HTTP APIs. An empty key deliberately fails closed.",
    "Key": "",
    "Issuer": "CloudDentalOffice",
    "Audience": "CloudDentalOffice"
  },
  "ServiceBus": {
    "//": "When ConnectionString is empty, the BookingRequestConsumer stays idle (no broker).",
    "ConnectionString": "",
    "BookingTopic": "booking-requests",
    "BookingSubscription": "scheduling",
    "SchedulingAvailabilityTopic": "scheduling-availability",
    "SchedulingAvailabilitySubscription": "zocdoc",
    "ZocdocWebhookTopic": "zocdoc-webhooks",
    "ZocdocWebhookSubscription": "scheduling",
    "AppointmentLifecycleTopic": "appointment-lifecycle",
    "AppointmentLifecycleSubscription": "zocdoc"
  },
  "Services": {
    "PatientService": "http://patient-service:5101/",
    "PatientServiceClients": []
  },
  "InternalApi": {
    "PublicIntakeClients": []
  },
  "PublicAvailability": {
    "SlotTokenKey": ""
  },
  "SearchConsole": {
    "RepairWindowDays": 7,
    "InitialBackfillDays": 90,
    "PageSize": 25000,
    "MaxRowsPerDay": 50000,
    "SyncHourUtc": 6,
    "MaxAttempts": 3,
    "PollMinutes": 15,
    "LeaseSeconds": 600
  }
}
