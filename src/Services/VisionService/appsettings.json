{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "VisionService": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5108"
      }
    }
  },

  "DatabaseProvider": "SQLite",
  "ConnectionStrings": {
    "VisionDb": "Data Source=vision.db"
  },

  "Jwt": {
    "//": "Required for staff vision APIs and the hub. An empty key fails startup outside Development.",
    "Key": "",
    "Issuer": "CloudDentalOffice",
    "Audience": "CloudDentalOffice"
  },

  "DeviceApi": {
    "//": "Per-tenant edge-device keys (TenantId + ApiKey of at least 32 characters) must come from a secret-backed provider.",
    "Clients": []
  },

  "OcrProvider": "Mock",
  "CorrelationProvider": "Mock",

  "ApiGatewayUrl": "http://localhost:5200",

  "AzureAiVision": {
    "Endpoint": "https://your-resource.cognitiveservices.azure.com",
    "ApiKey": "",
    "ModelVersion": "2024-02-01"
  },

  "AzureBlobStorage": {
    "AccountName": "",
    "ContainerName": "vision-media",
    "SasToken": ""
  },

  "PracticeHours": {
    "OpenTime": "08:00:00",
    "CloseTime": "17:00:00",
    "OpenSaturday": false
  },

  "AzureOpenAI": {
    "Endpoint": "",
    "ApiKey": "",
    "DeploymentName": "gpt-4",
    "Enabled": false
  }
}
