{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IntakeDb": "Data Source=intake.db"
  },
  "IntegrationInbox": {
    "BatchSize": 20,
    "PollIntervalSeconds": 2,
    "MaxAttempts": 8,
    "LeaseSeconds": 60,
    "InitialRetrySeconds": 5,
    "MaximumRetrySeconds": 300,
    "AdminClients": []
  },
  "PublicBooking": {
    "//": "Public website booking intake (POST /api/public/booking-requests). Disabled until configured.",
    "Enabled": false,
    "RequireAvailabilitySelection": false,
    "Source": "PublicWebsite",
    "Clients": []
  },
  "TrustedProxies": [],
  "ZocdocWebhooks": {
    "//": "Trusted route-to-tenant mappings. WebhookSecret values must come from secret-backed environment variables.",
    "Integrations": []
  },
  "Services": {
    "SchedulingService": "http://scheduling-service:5102/",
    "SchedulingServiceClients": []
  },
  "ServiceBus": {
    "//": "Website booking returns 503 when empty. Verified Zocdoc webhooks remain durable in the inbox until the broker returns.",
    "ConnectionString": "",
    "BookingTopic": "booking-requests",
    "ZocdocWebhookTopic": "zocdoc-webhooks"
  }
}
